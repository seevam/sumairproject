# Comma-separated list of allowed frontend origins. Defaults to "*" (dev only).
ALLOWED_ORIGINS=https://your-app.vercel.app

# Where the SQLite file lives. On Render's free tier use /tmp (ephemeral).
POSTUREGUARD_DB=./postureguard.db

# Postgres connection string. Required on any serverless host (Vercel) and
# strongly recommended on Render free tier: without it, SQLite lives on an
# ephemeral filesystem and server-side data does not survive a restart.
DATABASE_URL=postgresql://user:password@host/dbname
