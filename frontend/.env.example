# Optional. Leave unset to run fully local-first with no backend at all.
# When set, completed sessions are mirrored to this Flask API.
# Camera frames and pose landmarks are never sent, regardless of this setting.
VITE_API_BASE_URL=

# Optional. Without it the app runs guest-only and the Clerk SDK is never
# downloaded. With it, sign-in and sign-up appear on /auth alongside guest mode.
VITE_CLERK_PUBLISHABLE_KEY=
